programa
{
	funcao inicio()
	{
		cadeia nome
		real nota

		escreva("Digite seu nome: ")
		leia(nome)

		escreva("Qual foi sua nota?: ")
		leia(nota)

		se (nota >= 6.0) {
			escreva("Aluno Aprovado!")
		}
		
		senao {
			escreva("Reprovado")
		}
	}
}
